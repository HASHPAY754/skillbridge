# SkillBridge Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas or Local Connection String
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/skillbridge

# JWT Authentication Secret & Lifespan
JWT_SECRET=your_jwt_secret_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Fallback in-memory database for local evaluation when MongoDB is not running locally
ALLOW_IN_MEMORY_DB=true
